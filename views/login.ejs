<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>
    <div class="w-full h-screen text-white bg-zinc-900 p-10">
        <h1 class="text-2xl mb-4 ">Login</h1>
        <form action="/login" method="post">

            <input class="px-3 py-2 placeholder:text-white rounded-md bg-transparent border-2 border-zinc-800"
                type="text" name="email" placeholder="email">
            <input class="px-3 py-2 placeholder:text-white rounded-md bg-transparent border-2 border-zinc-800"
                type="text" name="password" placeholder="password">

            <input class="px-5 py-2 rounded-md bg-blue-400" type="submit" value="login">
        </form>
    </div>
</body>

</html>